{
  "name": "0x2f",
  "version": "0.1.1",
  "description": "0x2F \u2014 manage engineering work, not AI sessions. A task-native wrapper around coding agents with a local-first Web UI.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cli",
    "tasks",
    "coding-agents",
    "local-first",
    "claude-code",
    "deepseek-harness",
    "acp",
    "gemini-cli"
  ],
  "bin": {
    "2f": "src/cli.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleksandrMalinin/0x2f.git"
  },
  "homepage": "https://github.com/AleksandrMalinin/0x2f#readme",
  "scripts": {
    "start": "node src/cli.mjs",
    "check": "find src test relay scripts deploy -name node_modules -prune -o \\( -name '*.mjs' -o -name '*.js' \\) -exec node --check {} \\; && python3 -c \"import ast,glob,sys; [ast.parse(open(f, encoding='utf-8').read(), f) for f in glob.glob('test/tui-pty/*.py')]\"",
    "test": "node --test \"test/*.test.mjs\"",
    "test:tui": "node --test test/tui-pty-e2e.test.mjs",
    "dogfood:tui": "node scripts/dogfood-tui.mjs",
    "review:tui": "node scripts/review-tui.mjs",
    "build:client": "node deploy/client/build.mjs",
    "verify:phone": "node scripts/verify-phone.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "ws": "^8.21.3"
  }
}
